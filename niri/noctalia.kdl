layout {

    focus-ring {
        active-color   "#ffa9fa"
        inactive-color "#181117"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffa9fa"
        inactive-color "#181117"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ffa9fa"
        inactive-color "#771c7c"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffa9fa80"
    }
}

recent-windows {
    highlight {
        active-color "#ffa9fa"
        urgent-color "#ffb4ab"
    }
}
